{
  "expo": {
    "name": "biblewise-app",
    "slug": "biblewise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "biblewise",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mahlv.biblewise",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.mahlv.biblewise"]
      }
    },
    "android": {
      "package": "com.mahlv.biblewise",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Permita que o BibleWise use o microfone para gravar a mensagem.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-sharing",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "BiblewiseQuote",
              "label": "Biblewise",
              "description": "Versículos e frases inspiradoras, atualizados duas vezes ao dia.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "320dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 21600000
            }
          ],
          "fonts": [
            "./node_modules/@expo-google-fonts/eb-garamond/400Regular_Italic/EBGaramond_400Regular_Italic.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold/PlusJakartaSans_600SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o BibleWise acesse suas fotos para escolher a foto do perfil."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Permita que o BibleWise acesse suas fotos.",
          "savePhotosPermission": "Permita que o BibleWise salve as artes das frases na sua galeria.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "782ea83a-5982-471a-af28-b0d78514d9ac"
      }
    },
    "owner": "mahlv"
  }
}
