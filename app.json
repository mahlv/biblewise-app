{
  "expo": {
    "name": "biblewise-app",
    "slug": "biblewise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "biblewise",
    "locales": {
      "pt": "./locales/native/pt.json",
      "es": "./locales/native/es.json",
      "fr": "./locales/native/fr.json",
      "it": "./locales/native/it.json",
      "de": "./locales/native/de.json",
      "nb": "./locales/native/nb.json",
      "ru": "./locales/native/ru.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mahlv.biblewise",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.mahlv.biblewise"
        ]
      }
    },
    "android": {
      "package": "com.mahlv.biblewise",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow BibleWise to use the microphone to record the message.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-sharing",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "BiblewiseQuote",
              "label": "Biblewise",
              "description": "Inspiring verses and quotes, refreshed twice a day.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "320dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 21600000
            }
          ],
          "fonts": [
            "./node_modules/@expo-google-fonts/eb-garamond/500Medium/EBGaramond_500Medium.ttf",
            "./node_modules/@expo-google-fonts/eb-garamond/400Regular_Italic/EBGaramond_400Regular_Italic.ttf",
            "./node_modules/@expo-google-fonts/eb-garamond/700Bold/EBGaramond_700Bold.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold/PlusJakartaSans_600SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BibleWise to access your photos to choose your profile picture."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow BibleWise to access your photos to choose your profile picture.",
          "savePhotosPermission": "Allow BibleWise to save the quote images to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-asset",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "782ea83a-5982-471a-af28-b0d78514d9ac"
      }
    },
    "owner": "mahlv"
  }
}
